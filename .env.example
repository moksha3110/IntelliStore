# ==== Shared / Infra ====
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=intellistore
POSTGRES_PASSWORD=intellistore_dev_password
POSTGRES_DB=intellistore

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=intellistore
RABBITMQ_PASSWORD=intellistore_dev_password
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=intellistore
MINIO_ROOT_PASSWORD=intellistore_dev_password
MINIO_BUCKET=intellistore-chunks

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==== Service Ports ====
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
METADATA_SERVICE_PORT=4002
STORAGE_SERVICE_PORT=4003
REPLICATION_SERVICE_PORT=4004
AI_ANALYTICS_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006

# ==== Storage service ====
METADATA_SERVICE_URL=http://localhost:4002
CHUNK_SIZE_BYTES=4194304
MAX_UPLOAD_SIZE_BYTES=104857600
# STORAGE_DATA_DIR=./services/storage-service/.data/chunks
# STORAGE_BACKEND=minio takes chunk bytes to the MinIO container; use "local" for a filesystem fallback (e.g. CI without Docker)
STORAGE_BACKEND=minio
MINIO_USE_SSL=false
CHUNK_UPLOADS_QUEUE=chunk-uploads
FILE_ACCESS_QUEUE=file-access-events

# ==== Replication service ====
# Number of additional copies made beyond the primary bucket (simulated nodes are
# separate buckets in the same MinIO instance, since this project runs one server).
REPLICATION_FACTOR=2
# A node is marked unhealthy once it's gone this long without a heartbeat.
HEARTBEAT_STALE_MS=15000
# How often the staleness sweep runs.
HEARTBEAT_SWEEP_INTERVAL_MS=5000
# How often the self-healing reconciliation loop runs.
SELF_HEALING_INTERVAL_MS=10000

# ==== AI analytics service ====
REPLICATION_SERVICE_URL=http://localhost:4004
# Hot/cold scoring heuristic (deterministic feature scoring, not a trained model - see README).
RECENCY_HALF_LIFE_DAYS=14
FREQUENCY_CAP=20
HOT_THRESHOLD=50
COLD_AGE_THRESHOLD_DAYS=30

# ==== Frontend ====
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_METADATA_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_STORAGE_SERVICE_URL=http://localhost:4003
NEXT_PUBLIC_REPLICATION_SERVICE_URL=http://localhost:4004
NEXT_PUBLIC_AI_ANALYTICS_SERVICE_URL=http://localhost:4005
